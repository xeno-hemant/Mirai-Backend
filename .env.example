# =====================================================================
# Mirai Environment Variables Checklist (.env.example)
# =====================================================================

# 1. Supabase (Client-facing)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 2. Supabase (Server-only / Elevated)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Upstash Redis (Server-only - Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AY5pAAIjcDEy..."

# 4. Inngest (Background Jobs)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="signkey-prod-..."

# 5. Resend (Email Deliverability)
RESEND_API_KEY="re_123456789..."
EMAIL_FROM="Mirai <noreply@mirai.build>"

# 6. OAuth (Optional Provider Config)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
